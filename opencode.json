{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "bai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "B.ai",
      "options": {
        "baseURL": "https://api.b.ai/v1"
      },
      "models": {
        "qwen3.8-flash": { "name": "Qwen 3.8 Flash" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "deepseek-v4-flash-vision-exp": { "name": "DeepSeek V4 Flash 16k" },
        "hy3": { "name": "Hy3" },
        "glm-5.3-flash": { "name": "GLM-5.3 Flash" },
        "mimo-v2.5": { "name": "Mimo V2.5" }
      }
    }
  },
  "agent": {
    "explore": {
      "model": "bai/deepseek-v4-flash",
      "mode": "subagent",
      "description": "Fast agent specialized for exploring codebases.",
      "permission": { "edit": "deny" }
    },
    "general": {
      "model": "bai/qwen3.8-flash",
      "mode": "subagent",
      "description": "General-purpose agent for researching complex questions and executing multi-step tasks."
    },
    "review": {
      "model": "bai/glm-5.3-flash",
      "mode": "subagent",
      "description": "Read-only reviewer for second opinions and validation of delegated output.",
      "permission": { "edit": "deny" }
    },
    "deep": {
      "model": "bai/deepseek-v4-flash-vision-exp",
      "mode": "subagent",
      "description": "Deep-context agent (DeepSeek V4 Flash 16k) for tasks needing additional context capacity."
    }
  },
  "model": "bai:gpt-5.5"
}
